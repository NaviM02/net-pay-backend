# Copy this file to `.env` (never commit it) and fill in real values.

# Database
DB_URL=jdbc:postgresql://localhost:5432/netpay_db
DB_USERNAME=postgres
DB_PASSWORD=1234@asdf

# Auth
JWT_EXPIRATION=3600
JWT_SECRET=jwt_secret

# Cloudinary (receipt PDF storage)
# Dashboard > Product Environment Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=netpay/receipts
