# Copy this file to `.env` (never commit it) and fill in real values.

# Database
DB_URL=jdbc:postgresql://localhost:5432/netpay_db
DB_USERNAME=postgres
DB_PASSWORD=

# Auth
JWT_EXPIRATION=3600
# Generate a random value of at least 32 bytes; never reuse example/test values.
JWT_SECRET=

# Cloudinary (receipt PDF storage)
# Dashboard > Product Environment Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=netpay/receipts
CLOUDINARY_UPLOADS_FOLDER=netpay/uploads

# Gmail API (OAuth2; no SMTP)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM_EMAIL=

# Password recovery
PASSWORD_RESET_EXPIRATION_MINUTES=30
# URL base del frontend para el enlace de recuperación.
# No usar comillas (esto es un archivo .properties). Si el frontend usa hash routing, incluí "/#":
FRONTEND_BASE_URL=http://localhost:4200/#

# CORS: orígenes del frontend permitidos, separados por comas
CORS_ALLOWED_ORIGINS=http://localhost:4200
